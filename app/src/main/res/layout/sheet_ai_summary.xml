<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top Fixed Area: Handle drag indicator + Badges + Mode Selector Tabs -->
    <LinearLayout
        android:id="@+id/layoutAiTopFixedArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:animateLayoutChanges="true">

        <!-- Handle drag indicator -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#1E2D3D" />

        <!-- Header: Badges & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_fokk_ai_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Fokk AI Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="FOKK AI"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Unboxed Real Source Logo & Publication Name -->
            <LinearLayout
                android:id="@+id/layoutSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgSourceFavicon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_world"
                    android:contentDescription="Source Logo" />

                <TextView
                    android:id="@+id/textSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxWidth="160dp"
                    android:text="Web Source"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Save Summary Button -->
            <ImageButton
                android:id="@+id/btnSaveSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_secondary"
                android:contentDescription="Save Summary" />

            <!-- Fokk AI History Button -->
            <ImageButton
                android:id="@+id/btnAiHistory"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clock"
                app:tint="@color/text_secondary"
                android:contentDescription="Fokk AI History" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnCloseSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Interactive Mode Selector Tabs -->
        <LinearLayout
            android:id="@+id/layoutAiTabsContainer"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_stat_chip"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnTabAiSummary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_tab_selected"
                android:gravity="center"
                android:text="Summary &amp; TTS"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabAiChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Ask AI"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabAiAudit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Truth &amp; Bias Audit"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>


    </LinearLayout>

    <!-- Main Dynamic Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SECTION 1: SUMMARY & TTS MODE (Scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutAiSummarySection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Lead Image Container (Desktop Parity) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutLeadImageCard"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0D121D"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgAiSummaryLead"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Article Lead Image" />
            </androidx.cardview.widget.CardView>

            <!-- Open-World Trust & Credibility Verdict Header -->
            <LinearLayout
                android:id="@+id/layoutSummaryTrustBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_engine_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="#34D399" />

                    <TextView
                        android:id="@+id/textSummaryTrustVerdict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Credibly reported, not yet official"
                        android:textColor="#34D399"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSummaryTrustScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="88%"
                        android:textColor="#34D399"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textSummaryTrustReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Corroborated across independent newsrooms; consistent reporting across major outlets."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <!-- Source Provenance Breadcrumb (Open-World, no bulky card) -->
                <LinearLayout
                    android:id="@+id/layoutSummarySourceChain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROVENANCE: "
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/textSummarySourceChainFlow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original Source -> Aggregator -> Active Session"
                        android:textColor="#38BDF8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Prominent Article Title -->
            <TextView
                android:id="@+id/textSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Executive Brief"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Metadata: Reading Time & Device Intelligence -->
            <TextView
                android:id="@+id/textSummaryMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="3 min read • Fokk AI Truth Engine"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Executive Paragraph Summary -->
            <TextView
                android:id="@+id/textAiExecutiveHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="EXECUTIVE SUMMARY"
                android:textColor="@color/fokk_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAiExecutiveSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:lineSpacingExtra="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAiKeyInsightsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="KEY INSIGHTS &amp; ANALYSIS"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Bullets / Sections Container -->
            <LinearLayout
                android:id="@+id/layoutSummaryBullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- What's Missing Context Callout (Accent Border, Unboxed) -->
            <LinearLayout
                android:id="@+id/layoutSummaryWhatsMissing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:background="#0A1322"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="#FBBF24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WHAT'S MISSING"
                        android:textColor="#FBBF24"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/textSummaryWhatsMissing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Awaiting official documentation."
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2.5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Key Metrics Section -->
            <TextView
                android:id="@+id/textMetricsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="KEY METRICS &amp; FIGURES"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Deep-Dive Curiosity Questions (Desktop Parity) -->
            <TextView
                android:id="@+id/textQuestionsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DEEP-DIVE QUESTIONS"
                android:textColor="@color/fokk_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutFollowUpQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Multi-Source Intelligence Header & Evidence Drawer (Positioned at Bottom) -->
            <LinearLayout
                android:id="@+id/layoutAiCorroborationHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textAiCorroborationStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MULTI-SOURCE EVIDENCE DRAWER"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/textAiSourcesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0 Sources"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horizontal Evidence Drawer -->
            <HorizontalScrollView
                android:id="@+id/scrollAiSources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutAiSourcesList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Voice Selector & Reading Controls (Moved to Bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTtsVoiceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="Voice: Male"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#131B2B"
                    app:strokeColor="#24344D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="17dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textTtsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopySummary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Copy Summary"
                    android:textColor="#000000"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fokk_cyan"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListenSummary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Read Aloud"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#131B2B"
                    app:strokeColor="#24344D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SECTION 2: TRUTH & BIAS AUDIT MODE (Scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutAiRealityAuditSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <!-- Unboxed Reality Credibility Verdict Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REPORTING STATUS &amp; VERDICT"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/textAiCredibilityScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Credibly Reported"
                        android:textColor="#34D399"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textAiBiasRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_engine_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Neutral Tone"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressCredibilityScore"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="88"
                android:progressTint="#34D399" />

            <TextView
                android:id="@+id/textAiCredibilityReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Corroborated across independent newsrooms; awaiting official announcement."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- Source Provenance Breadcrumb (Open-World, no bulky card) -->
            <LinearLayout
                android:id="@+id/layoutAuditSourceChain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROVENANCE: "
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAuditSourceChainFlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original Source -> Aggregator -> Current Page"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Multi-Layer Cross-Examination Matrix -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="VERIFICATION &amp; AUTHENTICITY LAYERS"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Layer 1: Page Authenticity & Distribution Channel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYER 1 · PAGE AUTHENTICITY &amp; DISTRIBUTION CHANNEL"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAiSourceReputation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Established reporting entity. Verified domain identity with zero detected phishing, clickbait masking, or malicious redirect patterns."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Layer 2: Rhetorical Stance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYER 2 · RHETORICAL STANCE &amp; BIAS SPECTRUM"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAiBiasAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Objective neutral tone. Factual reporting structure with low sensationalism and documented attribution."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Layer 3: Evidence Density -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYER 3 · EVIDENCE DENSITY &amp; CITATIONS"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAiEvidenceDensity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="High empirical density. Verified multi-passage evidence corroborated across primary wire records."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Extracted Claims Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="KEY VERIFIABLE FACTUAL CLAIMS"
                android:textColor="@color/fokk_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/layoutAiExtractedClaims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SECTION 3: ASK AI / RESEARCH INTERACTIVE MODE -->
        <LinearLayout
            android:id="@+id/layoutAiChatSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Dynamic Chat Responses Container -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollAiChatResponses"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/layoutAiChatResponses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />
            </androidx.core.widget.NestedScrollView>

            <!-- Bottom Command Card (Always anchored to bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp"
                android:paddingTop="4dp">

                <!-- Command Card Outer Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_engine_capsule"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp">

                    <!-- Hint + Text Input Area -->
                    <EditText
                        android:id="@+id/editAiUserQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Ask Fokk AI or paste any rumor, headline, or claim to verify..."
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="4"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine" />

                    <!-- Divider line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1E2D3D" />

                    <!-- Action Row: Voice on LEFT, Enter/Send on RIGHT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Voice Input Button (white circular waveform on the LEFT) -->
                        <ImageButton
                            android:id="@+id/btnAiVoiceInput"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_voice_circle"
                            android:src="@drawable/btn_voice_waveform"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            android:contentDescription="Voice Input" />

                        <!-- Spacer pushing send button to the RIGHT -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Enter / Send Button on the RIGHT (just like before!) -->
                        <ImageButton
                            android:id="@+id/btnSendAiQuestion"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_voice_circle"
                            android:src="@drawable/ic_send"
                            app:tint="#000000"
                            android:scaleType="centerInside"
                            android:padding="9dp"
                            android:contentDescription="Send Question" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Caution Notice Below Command Card -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:text="AI can make mistakes and may surface imperfect media. Always verify claims with primary direct links."
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
