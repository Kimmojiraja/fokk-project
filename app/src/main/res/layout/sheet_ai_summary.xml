<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0E18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle drag indicator -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#24344D" />

        <!-- Header: Badges & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOKK SUMMARY"
                    android:textColor="@color/fokk_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Source Logo & Host Badge -->
            <LinearLayout
                android:id="@+id/layoutSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_engine_capsule"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgSourceFavicon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_world"
                    app:tint="@color/fokk_cyan"
                    android:contentDescription="Source Logo" />

                <TextView
                    android:id="@+id/textSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Web Source"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Save Summary Button -->
            <ImageButton
                android:id="@+id/btnSaveSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_secondary"
                android:contentDescription="Save Summary" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnCloseSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Prominent Article Title -->
        <TextView
            android:id="@+id/textSummaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Executive Brief"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Metadata: Reading Time & Device Intelligence -->
        <TextView
            android:id="@+id/textSummaryMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="3 min read • 100% On-Device AI • Zero Server Latency"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Voice Selector & Reading Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTtsVoiceToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🎙️ Voice: Male"
                android:textColor="@color/fokk_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#131B2B"
                app:strokeColor="#24344D"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textTtsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#1E293B" />

        <!-- Executive Paragraph Summary -->
        <TextView
            android:id="@+id/textAiExecutiveHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="EXECUTIVE SUMMARY"
            android:textColor="@color/fokk_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textAiExecutiveSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:lineSpacingExtra="5dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textAiKeyInsightsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="KEY INSIGHTS &amp; ANALYSIS"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Bullets / Sections Container -->
        <LinearLayout
            android:id="@+id/layoutSummaryBullets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Key Metrics Section -->
        <TextView
            android:id="@+id/textMetricsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KEY METRICS &amp; FIGURES"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopySummary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Copy Fokk Summary"
                android:textColor="#000000"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:backgroundTint="@color/fokk_cyan"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListenSummary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Read Aloud 🔊"
                android:textColor="@color/fokk_cyan"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:backgroundTint="#131B2B"
                app:strokeColor="@color/fokk_cyan"
                app:strokeWidth="1dp"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
