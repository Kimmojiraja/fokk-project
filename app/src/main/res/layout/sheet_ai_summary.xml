<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle drag indicator -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#1E2D3D" />

        <!-- Header: Badges & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_fokk_ai_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Fokk AI Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="FOKK AI"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Unboxed Real Source Logo & Publication Name -->
            <LinearLayout
                android:id="@+id/layoutSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgSourceFavicon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_world"
                    android:contentDescription="Source Logo" />

                <TextView
                    android:id="@+id/textSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Web Source"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Save Summary Button -->
            <ImageButton
                android:id="@+id/btnSaveSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_secondary"
                android:contentDescription="Save Summary" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnCloseSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Interactive Mode Selector Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_stat_chip"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnTabAiSummary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_tab_selected"
                android:gravity="center"
                android:text="Summary &amp; TTS"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabAiAudit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Truth &amp; Bias Audit"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabAiChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Ask AI"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- SECTION 1: SUMMARY & TTS MODE                                  -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/layoutAiSummarySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Lead Image Container (Desktop Parity) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutLeadImageCard"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0D121D"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgAiSummaryLead"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Article Lead Image" />
            </androidx.cardview.widget.CardView>

            <!-- Prominent Article Title -->
            <TextView
                android:id="@+id/textSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Executive Brief"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Metadata: Reading Time & Device Intelligence -->
            <TextView
                android:id="@+id/textSummaryMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="3 min read • 100% On-Device AI • Zero Server Latency"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />



            <!-- Executive Paragraph Summary -->
            <TextView
                android:id="@+id/textAiExecutiveHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="EXECUTIVE SUMMARY"
                android:textColor="@color/fokk_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAiExecutiveSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:lineSpacingExtra="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAiKeyInsightsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="KEY INSIGHTS &amp; ANALYSIS"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Bullets / Sections Container -->
            <LinearLayout
                android:id="@+id/layoutSummaryBullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Key Metrics Section -->
            <TextView
                android:id="@+id/textMetricsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="KEY METRICS &amp; FIGURES"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Deep-Dive Curiosity Questions (Desktop Parity) -->
            <TextView
                android:id="@+id/textQuestionsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DEEP-DIVE QUESTIONS"
                android:textColor="@color/fokk_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutFollowUpQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Voice Selector & Reading Controls (Moved to Bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTtsVoiceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="Voice: Male"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#131B2B"
                    app:strokeColor="#24344D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="17dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textTtsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopySummary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Copy Summary"
                    android:textColor="#000000"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fokk_cyan"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListenSummary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Read Aloud"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#131B2B"
                    app:strokeColor="#24344D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- SECTION 2: TRUTH & BIAS AUDIT MODE                             -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/layoutAiRealityAuditSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Unboxed Reality Credibility Verdict Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REALITY VERDICT &amp; CONSENSUS"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/textAiCredibilityScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="94% Verified Consensus"
                        android:textColor="#34D399"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textAiBiasRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_engine_capsule"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Neutral Tone"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressCredibilityScore"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="94"
                android:progressTint="#34D399" />

            <!-- TrustMeBro Multi-Layer Cross-Examination Matrix -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="FORENSIC CROSS-EXAMINATION MATRIX"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Layer 1: Domain Authenticity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYER 1 · DOMAIN &amp; INFRASTRUCTURE IDENTITY"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAiSourceReputation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Established reporting entity. Verified domain identity with zero detected phishing, clickbait masking, or malicious redirect patterns."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Layer 2: Rhetorical Stance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYER 2 · RHETORICAL STANCE &amp; BIAS SPECTRUM"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAiBiasAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Objective neutral tone. Factual reporting structure with low sensationalism and documented attribution."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Layer 3: Evidence Density -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYER 3 · EVIDENCE DENSITY &amp; CITATIONS"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/textAiEvidenceDensity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="High empirical density. Verified multi-passage evidence corroborated across primary wire records."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Extracted Claims Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="KEY VERIFIABLE FACTUAL CLAIMS"
                android:textColor="@color/fokk_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/layoutAiExtractedClaims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- SECTION 3: ASK AI / RESEARCH INTERACTIVE MODE                  -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/layoutAiChatSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Dynamic Chat Responses Container -->
            <LinearLayout
                android:id="@+id/layoutAiChatResponses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <!-- Bottom Command Card (Image 3 reference) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Command Card Outer Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_engine_capsule"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp">

                    <!-- Hint + Text Input Area -->
                    <EditText
                        android:id="@+id/editAiUserQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Ask Fokk AI or paste any rumor, headline, or claim to verify..."
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="4"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine" />

                    <!-- Divider line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1E2D3D" />

                    <!-- Action Row: + | Verify v | spacer | Voice Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Plus Button -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="#94A3B8"
                            android:textSize="20sp"
                            android:paddingEnd="6dp" />

                        <!-- Verify dropdown pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_engine_capsule"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verify"
                                android:textColor="#E2E8F0"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="v"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Spacer -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Voice Input Button (white circular waveform, Image 3) -->
                        <ImageButton
                            android:id="@+id/btnAiVoiceInput"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_voice_circle"
                            android:src="@drawable/btn_voice_waveform"
                            android:scaleType="fitCenter"
                            android:padding="10dp"
                            android:contentDescription="Voice Input" />

                        <!-- Hidden send button retained for binding compatibility -->
                        <ImageButton
                            android:id="@+id/btnSendAiQuestion"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:contentDescription="Send" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Caution Notice Below Command Card -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="AI can make mistakes and may surface imperfect media. Always verify claims with primary direct links."
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
