<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0E18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle drag indicator -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#24344D" />

        <!-- Header: Badges & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOKK AI"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Source Logo & Host Badge -->
            <LinearLayout
                android:id="@+id/layoutSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_engine_capsule"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgSourceFavicon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_world"
                    app:tint="@color/fokk_cyan"
                    android:contentDescription="Source Logo" />

                <TextView
                    android:id="@+id/textSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Web Source"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Save Summary Button -->
            <ImageButton
                android:id="@+id/btnSaveSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_secondary"
                android:contentDescription="Save Summary" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnCloseSummary"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Interactive Mode Selector Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_stat_chip"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnTabAiSummary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_tab_selected"
                android:gravity="center"
                android:text="Summary &amp; TTS"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabAiAudit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Truth &amp; Bias Audit"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabAiChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Ask AI"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- SECTION 1: SUMMARY & TTS MODE                                  -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/layoutAiSummarySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Lead Image Container (Desktop Parity) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutLeadImageCard"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0D121D"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgAiSummaryLead"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Article Lead Image" />
            </androidx.cardview.widget.CardView>

            <!-- Prominent Article Title -->
            <TextView
                android:id="@+id/textSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Executive Brief"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Metadata: Reading Time & Device Intelligence -->
            <TextView
                android:id="@+id/textSummaryMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="3 min read • 100% On-Device AI • Zero Server Latency"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Voice Selector & Reading Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTtsVoiceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="Voice: Male"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#131B2B"
                    app:strokeColor="#24344D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textTtsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#1E293B" />

            <!-- Executive Paragraph Summary -->
            <TextView
                android:id="@+id/textAiExecutiveHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="EXECUTIVE SUMMARY"
                android:textColor="@color/fokk_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAiExecutiveSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:lineSpacingExtra="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAiKeyInsightsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="KEY INSIGHTS &amp; ANALYSIS"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Bullets / Sections Container -->
            <LinearLayout
                android:id="@+id/layoutSummaryBullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Key Metrics Section -->
            <TextView
                android:id="@+id/textMetricsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="KEY METRICS &amp; FIGURES"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Deep-Dive Curiosity Questions (Desktop Parity) -->
            <TextView
                android:id="@+id/textQuestionsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DEEP-DIVE QUESTIONS"
                android:textColor="@color/fokk_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutFollowUpQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopySummary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Copy Summary"
                    android:textColor="#000000"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fokk_cyan"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListenSummary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Read Aloud"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#131B2B"
                    app:strokeColor="#24344D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- SECTION 2: TRUTH & BIAS AUDIT MODE                             -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/layoutAiRealityAuditSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Reality Credibility Score Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_chip"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REALITY CREDIBILITY SCORE"
                            android:textColor="#94A3B8"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/textAiCredibilityScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="94% Verified Consensus"
                            android:textColor="#34D399"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textAiBiasRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_engine_capsule"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Neutral Tone"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressCredibilityScore"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="92"
                    android:progressTint="#34D399" />
            </LinearLayout>

            <!-- Source Integrity Breakdown -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="SOURCE INTEGRITY &amp; REPUTATION"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/textAiSourceReputation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Established reporting entity. Verified domain identity with zero detected phishing, clickbait masking, or malicious redirect patterns."
                android:textColor="#E2E8F0"
                android:textSize="13.5sp"
                android:lineSpacingExtra="4dp" />

            <!-- Extracted Claims Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="EXTRACTED FACTUAL CLAIMS"
                android:textColor="@color/fokk_cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/layoutAiExtractedClaims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- SECTION 3: ASK AI / RESEARCH INTERACTIVE MODE                  -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/layoutAiChatSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Quick Action Prompt Chips (Horizontal Scroll) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="QUICK RESEARCH PROMPTS"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAiActionEli5"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Explain Like I'm 5"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAiActionStats"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Extract Key Numbers"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAiActionBias"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Check Bias &amp; Facts"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAiActionTakeaways"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="3 Core Takeaways"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAiActionFallacies"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Find Contradictions"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Dynamic Chat Responses Container -->
            <LinearLayout
                android:id="@+id/layoutAiChatResponses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <!-- Input Row: Question Input + Send Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_engine_capsule"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingVertical="4dp">

                <EditText
                    android:id="@+id/editAiUserQuestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Ask anything about this page or topic..."
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="13.5sp"
                    android:maxLines="3"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences" />

                <ImageButton
                    android:id="@+id/btnSendAiQuestion"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_send"
                    app:tint="@color/fokk_cyan"
                    android:contentDescription="Send AI Question" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
