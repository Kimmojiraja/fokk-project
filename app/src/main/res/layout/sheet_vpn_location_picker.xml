<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0F19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tab_counter"
            android:backgroundTint="#334155" />

        <!-- Header: Title + Subtitle + Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fokk Smart-Cloak &amp; Mesh Pro"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Zero-lag Smart-Cloak Free · Live Verified Mesh Pro"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseLocationSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_collapse"
                app:tint="#94A3B8"
                android:contentDescription="Close" />
        </RelativeLayout>

        <!-- SECTION 1: FOKK SMART-CLOAK (FREE · FULL NATIVE SPEED) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="FOKK SMART-CLOAK (FREE · FULL SPEED)"
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 0. Fokk Smart-Cloak (DoH + TLS SNI Fragmentation) -->
        <LinearLayout
            android:id="@+id/rowLocationSmartCloak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_shield_check"
                app:tint="#34D399"
                android:contentDescription="Fokk Smart-Cloak" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fokk Smart-Cloak"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="FREE · FASTEST"
                        android:textColor="#34D399"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Full native speed · Encrypted WebView DoH + TLS SNI bypass"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkLocationSmartCloak"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:contentDescription="Selected" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B" />

        <!-- SECTION 2: FOKK MESH PRO (IP-MASKING RELAYS) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="FOKK MESH PRO (IP-MASKING RELAYS)"
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 1. Optimal IP-Masking Relay -->
        <LinearLayout
            android:id="@+id/rowLocationAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_flag_optimal"
                android:contentDescription="Optimal Relay" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optimal IP-Mask Relay (Auto)"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="MESH"
                        android:textColor="#38BDF8"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Masks your IP via fastest verified dual-hop Fokk Mesh relay"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkLocationAuto"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:contentDescription="Selected" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B" />

        <!-- 2. Fokk Oblivious Edge Relay (RFC 9458) -->
        <LinearLayout
            android:id="@+id/rowLocationEdgeRelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_flag_optimal"
                app:tint="#F472B6"
                android:contentDescription="Oblivious Edge Relay" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fokk Oblivious Edge"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="300+ CITIES · &lt;40MS"
                        android:textColor="#F472B6"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Split-trust RFC 9458 oblivious edge worker · Zero logs"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkLocationEdgeRelay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:contentDescription="Selected" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B" />

        <!-- 3. Fokk Home-Base (Pair Desktop PC) -->
        <LinearLayout
            android:id="@+id/rowLocationHomeBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_shield_check"
                app:tint="#10B981"
                android:contentDescription="Home-Base PC Relay" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fokk Home-Base"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="PAIR PC · RESIDENTIAL"
                        android:textColor="#10B981"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textHomeBaseSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Relay through your own desktop PC · Dedicated unbannable IP"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkLocationHomeBase"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:contentDescription="Selected" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B" />

        <!-- SECTION 3: LIVE VERIFIED COUNTRIES (PRO) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="LIVE VERIFIED COUNTRIES (PRO)"
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/countryLocationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- SECTION 2: ADVANCED & ENTERPRISE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="ADVANCED &amp; ENTERPRISE"
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Custom Private Server -->
        <LinearLayout
            android:id="@+id/rowLocationCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_tab_counter"
                android:backgroundTint="#1E293B">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_check"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configure Private Server"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="PRO"
                        android:textColor="#38BDF8"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textCustomServerSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Connect to custom SOCKS5 / enterprise proxy (host:port)"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkLocationCustom"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
