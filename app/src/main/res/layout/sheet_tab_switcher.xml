<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTabSwitcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17">

    <!-- Top Navigation Header with Custom Segmented Capsule and Done Action -->
    <LinearLayout
        android:id="@+id/layoutTabsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <!-- Center/Left: Segmented Island Capsule Switcher -->
            <LinearLayout
                android:id="@+id/layoutSegmentedTabsTrack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_segmented_capsule_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <!-- Normal Tabs Option -->
                <LinearLayout
                    android:id="@+id/btnFilterNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segmented_capsule_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/imgNormalTabsIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_tab_windows"
                        app:tint="#0B0F17" />

                    <TextView
                        android:id="@+id/textNormalTabsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tabs"
                        android:textColor="#0B0F17"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textTabCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="1"
                        android:textColor="#0B0F17"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Private / Ghost Mode Option -->
                <LinearLayout
                    android:id="@+id/btnFilterPrivate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/imgPrivateTabsIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_incognito"
                        app:tint="#94A3B8" />

                    <TextView
                        android:id="@+id/textPrivateTabsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ghost Mode"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top Right: Clean Done Action Button -->
            <FrameLayout
                android:id="@+id/btnBottomTabCount"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:contentDescription="Return to browsing">

                <TextView
                    android:id="@+id/textDoneAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Done"
                    android:textColor="#38BDF8"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Compatibility invisible elements -->
            <FrameLayout
                android:id="@+id/btnToggleTabSearch"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/imgSearchHeaderIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </FrameLayout>

            <View
                android:id="@+id/indicatorNormalUnderline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/indicatorPrivateUnderline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- Expandable Search Input Row -->
        <LinearLayout
            android:id="@+id/layoutTabSearchBar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="#71717A" />

            <EditText
                android:id="@+id/editSearchTabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:background="@null"
                android:hint="Search tabs by title or URL..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnClearTabSearch"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="#A1A1AA"
                android:contentDescription="Clear tab search" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable 2-Column Tab Grid -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTabsGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTabsTopBar"
        android:layout_above="@id/cardBottomPill"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutTabsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Unique Asymmetric Studio Dock: Utility Icons on Left, Primary New Tab Pill on Right -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomPill"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#121826"
        app:cardCornerRadius="31dp"
        app:cardElevation="12dp"
        app:strokeColor="#1F293D"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 1. Search Open Tabs Action -->
            <FrameLayout
                android:id="@+id/btnBottomTabs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Search open tabs">

                <ImageView
                    android:id="@+id/imgBottomTabs"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- 2. Browsing History Action -->
            <FrameLayout
                android:id="@+id/btnBottomHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Browsing History">

                <ImageView
                    android:id="@+id/imgBottomHistory"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_history"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <!-- 3. Tab Options Menu Action -->
            <FrameLayout
                android:id="@+id/btnBottomMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tab options menu">

                <ImageView
                    android:id="@+id/imgBottomMenu"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <!-- Flexible Space to push New Tab pill to right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 4. Prominent New Tab Pill Button -->
            <LinearLayout
                android:id="@+id/btnNewTabSheet"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_new_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:contentDescription="Open new tab">

                <ImageView
                    android:id="@+id/imgCentralPlusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_add"
                    app:tint="#0B0F17" />

                <TextView
                    android:id="@+id/textNewTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="New Tab"
                    android:textColor="#0B0F17"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Compatibility Invisible Views for Seamless Build & API Compatibility -->
    <View
        android:id="@+id/btnCloseAllTabs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/btnNewPrivateTab"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>
