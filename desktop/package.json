{
  "name": "fokk-browser",
  "productName": "Fokk Browser",
  "version": "1.0.0",
  "description": "Fokk Shield Browser - Ultra-fast, zero-ad privacy browser for Desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack:linux": "electron-builder --linux --dir",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis portable",
    "dist": "electron-builder -wl"
  },
  "keywords": ["browser", "adblock", "privacy", "chromium", "fokk"],
  "homepage": "https://github.com/Kimmojiraja/fokk-project",
  "author": "Fokk Shield Team <rajakimmoji@gmail.com>",
  "license": "MIT",
  "build": {
    "appId": "com.adshield.fokk",
    "productName": "Fokk Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../app/src/main/assets",
        "to": "assets",
        "filter": [
          "fokk_start.html",
          "adblock_rules_curated.txt",
          "inject_adshield.js",
          "adblock_defusers.js"
        ]
      }
    ],
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Network;WebBrowser",
      "icon": "assets/icon.png",
      "maintainer": "Fokk Shield Team <rajakimmoji@gmail.com>"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  }
}
