{
  "name": "fokk-browser",
  "productName": "Fokk Browser",
  "version": "1.0.0",
  "description": "Fokk Shield Browser - Ultra-fast, zero-ad privacy browser for Desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack:linux": "electron-builder --linux --dir",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win zip -c.win.signAndEditExecutable=false",
    "dist:mac": "electron-builder --mac zip",
    "dist:all": "electron-builder --linux deb AppImage --win zip -c.win.signAndEditExecutable=false --mac zip",
    "dist": "electron-builder -wl"
  },
  "keywords": [
    "browser",
    "adblock",
    "privacy",
    "chromium",
    "fokk"
  ],
  "homepage": "https://github.com/Kimmojiraja/fokk-project",
  "author": "Fokk Shield Team <rajakimmoji@gmail.com>",
  "license": "MIT",
  "build": {
    "appId": "com.adshield.fokk",
    "productName": "Fokk Browser",
    "publish": {
      "provider": "github",
      "owner": "Kimmojiraja",
      "repo": "fokk-project"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "bin/**/*"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "../app/src/main/assets",
        "to": "assets",
        "filter": [
          "fokk_start.html",
          "fokk_about.html",
          "fokk_webtorrent.html",
          "fokk_reader.js",
          "fokk_reader.css",
          "fokk_summarizer.js",
          "fokko_content.js",
          "fokko_content.css",
          "adblock_rules_curated.txt",
          "blocklist_core.txt",
          "inject_adshield.js",
          "adblock_defusers.js"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icons",
      "maintainer": "Fokk Shield Team <rajakimmoji@gmail.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
